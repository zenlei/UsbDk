<Include>
    <?ifndef CoinstallerVersion ?>
        <?define CoinstallerVersion= "01011" ?>
    <?endif?>

    <?ifdef UsbDkARM64 ?>
        <!-- ARM64 driver package with emulated x64 and x86 user-mode binaries. -->
        <File Id="UsbDk.sys$(var.OsName)" Name="UsbDk.sys" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDk.sys" Vital="yes" KeyPath="yes" DiskId="1" ProcessorArchitecture="arm64"/>
        <File Id="UsbDk.inf$(var.OsName)" Name="UsbDk.inf" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDk.inf" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="arm64"/>

        <File Id="UsbDkHelper.dll$(var.OsName)" Name="UsbDkHelper.dll" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDkHelper.dll" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="x64">
            <CopyFile Id="Windows_UsbDkHelper.dll$(var.OsName)" DestinationProperty="$(var.System32Dir)"/>
        </File>
        <File Id="UsbDkController.exe$(var.OsName)" Name="UsbDkController.exe" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDkController.exe" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="x64" />
        <File Id="UsbDkInstHelper.exe$(var.OsName)" Name="UsbDkInstHelper.exe" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDkInstHelper.exe" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="x64" />
    <?else?>
        <File Id="UsbDk.sys$(var.OsName)" Name="UsbDk.sys" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDk.sys" Vital="yes" KeyPath="yes" DiskId="1" ProcessorArchitecture="$(var.UsbDkCpuArch)"/>
        <File Id="UsbDk.inf$(var.OsName)" Name="UsbDk.inf" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDk.inf" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="$(var.UsbDkCpuArch)"/>
        <File Id="UsbDkHelper.dll$(var.OsName)" Name="UsbDkHelper.dll" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDkHelper.dll" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="$(var.UsbDkCpuArch)">
            <CopyFile Id="Windows_UsbDkHelper.dll$(var.OsName)" DestinationProperty="$(var.System32Dir)"/>
        </File>

        <?if $(var.UsbDkHasWOW64) = yes ?>
            <File Id="WOW64_UsbDkHelper.dll$(var.OsName)" Name="UsbDkHelper_x86.dll" Source="..\x86\$(var.SourceSubPath)\UsbDk_Package\UsbDkHelper.dll" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="x86">
                <CopyFile Id="WOW64_UsbDkHelper.dll$(var.OsName)" DestinationProperty="$(var.SystemWOW64Dir)" DestinationName="UsbDkHelper.dll"/>
            </File>
        <?endif?>

        <File Id="UsbDkController.exe$(var.OsName)" Name="UsbDkController.exe" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDkController.exe" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="$(var.UsbDkCpuArch)" />
        <File Id="UsbDkInstHelper.exe$(var.OsName)" Name="UsbDkInstHelper.exe" Source="$(var.SourceSubPath)\UsbDk_Package\UsbDkInstHelper.exe" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="$(var.UsbDkCpuArch)" />

        <?if $(var.UsbDkHasCoinstaller) = yes ?>
            <File Id="WdfCoinstaller$(var.CoinstallerVersion).dll$(var.OsName)" Name="WdfCoInstaller$(var.CoinstallerVersion).dll" Source="$(var.SourceSubPath)\UsbDk_Package\WdfCoInstaller$(var.CoinstallerVersion).dll" Vital="yes" KeyPath="no" DiskId="1" ProcessorArchitecture="$(var.UsbDkCpuArch)"/>
        <?endif?>
    <?endif?>

    <?ifdef CoinstallerVersion ?>
        <?undef CoinstallerVersion ?>
    <?endif?>
</Include>
